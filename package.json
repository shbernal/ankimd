{
  "name": "ankimd-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Flashcard Markdown to and from Anki packages.",
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo build --output-logs=errors-only && oxlint --type-aware --deny-warnings",
    "prose": "charcheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "charcheck": "^0.4.0",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
