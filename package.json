{
  "name": "ankimd-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Flashcard Markdown to and from Anki packages.",
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo build --output-logs=errors-only && oxlint --type-aware --deny-warnings",
    "prose": "charcheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "charcheck": "^0.4.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
